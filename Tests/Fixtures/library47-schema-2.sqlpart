CREATE TRIGGER library_restore_cache_INSERT AFTER INSERT ON cache BEGIN DELETE FROM library_resource_adoptions WHERE kind IN ('toc','localNavigation') AND item=NEW.key; END;
CREATE TRIGGER library_restore_cache_UPDATE AFTER UPDATE ON cache BEGIN DELETE FROM library_resource_adoptions WHERE kind IN ('toc','localNavigation') AND item=OLD.key;DELETE FROM library_resource_adoptions WHERE kind IN ('toc','localNavigation') AND item=NEW.key; END;
CREATE TRIGGER library_restore_chapter_cache_DELETE AFTER DELETE ON chapter_cache BEGIN DELETE FROM library_resource_adoptions WHERE source_id=OLD.source_id AND book_id=OLD.book_id AND ((kind='chapterBody' AND item=CAST(OLD.chapter_index AS TEXT)) OR kind='localNavigation'); END;
CREATE TRIGGER library_restore_chapter_cache_INSERT AFTER INSERT ON chapter_cache BEGIN DELETE FROM library_resource_adoptions WHERE source_id=NEW.source_id AND book_id=NEW.book_id AND ((kind='chapterBody' AND item=CAST(NEW.chapter_index AS TEXT)) OR kind='localNavigation'); END;
CREATE TRIGGER library_restore_chapter_cache_UPDATE AFTER UPDATE OF source_id,book_id,chapter_index,title,url,content,cached_at,content_format_version ON chapter_cache BEGIN DELETE FROM library_resource_adoptions WHERE source_id=OLD.source_id AND book_id=OLD.book_id AND ((kind='chapterBody' AND item=CAST(OLD.chapter_index AS TEXT)) OR kind='localNavigation');DELETE FROM library_resource_adoptions WHERE source_id=NEW.source_id AND book_id=NEW.book_id AND ((kind='chapterBody' AND item=CAST(NEW.chapter_index AS TEXT)) OR kind='localNavigation'); END;
CREATE TRIGGER library_restore_library_book_identities_DELETE AFTER DELETE ON library_book_identities BEGIN DELETE FROM library_resource_adoptions WHERE library_book_id=OLD.id;INSERT INTO content_search_generations SELECT source_id,book_id,1 FROM library_local_alias_bindings WHERE library_book_id=OLD.id GROUP BY source_id,book_id ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1; END;
CREATE TRIGGER library_restore_library_book_identities_INSERT AFTER INSERT ON library_book_identities BEGIN DELETE FROM library_resource_adoptions WHERE library_book_id=NEW.id;INSERT INTO content_search_generations SELECT source_id,book_id,1 FROM library_local_alias_bindings WHERE library_book_id=NEW.id GROUP BY source_id,book_id ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1; END;
CREATE TRIGGER library_restore_library_book_identities_UPDATE AFTER UPDATE ON library_book_identities BEGIN DELETE FROM library_resource_adoptions WHERE library_book_id=OLD.id;INSERT INTO content_search_generations SELECT source_id,book_id,1 FROM library_local_alias_bindings WHERE library_book_id=OLD.id GROUP BY source_id,book_id ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1;DELETE FROM library_resource_adoptions WHERE library_book_id=NEW.id;INSERT INTO content_search_generations SELECT source_id,book_id,1 FROM library_local_alias_bindings WHERE library_book_id=NEW.id GROUP BY source_id,book_id ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1; END;
CREATE TRIGGER library_restore_library_chapter_bindings_DELETE AFTER DELETE ON library_chapter_bindings BEGIN DELETE FROM library_resource_adoptions WHERE binding_id=OLD.binding_id AND (kind='localNavigation' OR (kind IN ('chapterBody','mangaRequestSet','mangaMaterializedSet') AND chapter_key=OLD.chapter_key));INSERT INTO content_search_generations SELECT source_id,book_id,1 FROM library_local_alias_bindings WHERE binding_id=OLD.binding_id ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1; END;
CREATE TRIGGER library_restore_library_chapter_bindings_INSERT AFTER INSERT ON library_chapter_bindings BEGIN DELETE FROM library_resource_adoptions WHERE binding_id=NEW.binding_id AND (kind='localNavigation' OR (kind IN ('chapterBody','mangaRequestSet','mangaMaterializedSet') AND chapter_key=NEW.chapter_key));INSERT INTO content_search_generations SELECT source_id,book_id,1 FROM library_local_alias_bindings WHERE binding_id=NEW.binding_id ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1; END;
CREATE TRIGGER library_restore_library_chapter_bindings_UPDATE AFTER UPDATE ON library_chapter_bindings BEGIN DELETE FROM library_resource_adoptions WHERE binding_id=OLD.binding_id AND (kind='localNavigation' OR (kind IN ('chapterBody','mangaRequestSet','mangaMaterializedSet') AND chapter_key=OLD.chapter_key));INSERT INTO content_search_generations SELECT source_id,book_id,1 FROM library_local_alias_bindings WHERE binding_id=OLD.binding_id ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1;DELETE FROM library_resource_adoptions WHERE binding_id=NEW.binding_id AND (kind='localNavigation' OR (kind IN ('chapterBody','mangaRequestSet','mangaMaterializedSet') AND chapter_key=NEW.chapter_key));INSERT INTO content_search_generations SELECT source_id,book_id,1 FROM library_local_alias_bindings WHERE binding_id=NEW.binding_id ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1; END;
CREATE TRIGGER library_restore_library_local_alias_bindings_DELETE AFTER DELETE ON library_local_alias_bindings BEGIN DELETE FROM library_resource_adoptions WHERE source_id=OLD.source_id AND book_id=OLD.book_id;INSERT INTO content_search_generations VALUES(OLD.source_id,OLD.book_id,1) ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1; END;
CREATE TRIGGER library_restore_library_local_alias_bindings_INSERT AFTER INSERT ON library_local_alias_bindings BEGIN DELETE FROM library_resource_adoptions WHERE source_id=NEW.source_id AND book_id=NEW.book_id;INSERT INTO content_search_generations VALUES(NEW.source_id,NEW.book_id,1) ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1; END;
CREATE TRIGGER library_restore_library_local_alias_bindings_UPDATE AFTER UPDATE ON library_local_alias_bindings BEGIN DELETE FROM library_resource_adoptions WHERE source_id=OLD.source_id AND book_id=OLD.book_id;INSERT INTO content_search_generations VALUES(OLD.source_id,OLD.book_id,1) ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1;DELETE FROM library_resource_adoptions WHERE source_id=NEW.source_id AND book_id=NEW.book_id;INSERT INTO content_search_generations VALUES(NEW.source_id,NEW.book_id,1) ON CONFLICT(source_id,book_id) DO UPDATE SET generation=generation+1; END;
CREATE TRIGGER library_restore_library_update AFTER UPDATE ON library_identity_meta BEGIN
 DELETE FROM library_resource_adoptions;
 UPDATE content_search_generations SET generation=generation+1;
END;
CREATE TRIGGER library_restore_local_input_DELETE AFTER DELETE ON books BEGIN
 DELETE FROM library_resource_adoptions WHERE source_id='local' AND book_id=OLD.book_id;
END;
CREATE TRIGGER library_restore_local_input_INSERT BEFORE INSERT ON books
 WHEN EXISTS(SELECT 1 FROM books b WHERE b.book_id=NEW.book_id AND (json_extract(b.book_json,'$.variables.localBookOriginal') IS NOT json_extract(NEW.book_json,'$.variables.localBookOriginal') OR json_extract(b.book_json,'$.variables.localBookSourceSha256') IS NOT json_extract(NEW.book_json,'$.variables.localBookSourceSha256') OR json_extract(b.book_json,'$.variables.localBookRulesSha256') IS NOT json_extract(NEW.book_json,'$.variables.localBookRulesSha256'))) BEGIN
 DELETE FROM library_resource_adoptions WHERE source_id='local' AND book_id=NEW.book_id;
END;
CREATE TRIGGER library_restore_local_input_UPDATE AFTER UPDATE ON books
 WHEN OLD.book_id IS NOT NEW.book_id OR (json_extract(OLD.book_json,'$.variables.localBookOriginal') IS NOT json_extract(NEW.book_json,'$.variables.localBookOriginal') OR json_extract(OLD.book_json,'$.variables.localBookSourceSha256') IS NOT json_extract(NEW.book_json,'$.variables.localBookSourceSha256') OR json_extract(OLD.book_json,'$.variables.localBookRulesSha256') IS NOT json_extract(NEW.book_json,'$.variables.localBookRulesSha256')) BEGIN
 DELETE FROM library_resource_adoptions WHERE source_id='local' AND (book_id=OLD.book_id OR book_id=NEW.book_id);
END;
