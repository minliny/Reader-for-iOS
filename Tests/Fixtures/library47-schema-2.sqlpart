CREATE TRIGGER library_restore_sources_DELETE AFTER DELETE ON sources BEGIN
 DELETE FROM library_resource_adoptions WHERE source_id=OLD.source_id;
END;
CREATE TRIGGER library_restore_sources_INSERT AFTER INSERT ON sources BEGIN
 DELETE FROM library_resource_adoptions WHERE source_id=NEW.source_id;
END;
CREATE TRIGGER library_restore_sources_UPDATE AFTER UPDATE ON sources
 WHEN OLD.source_id IS NOT NEW.source_id OR OLD.source_json IS NOT NEW.source_json BEGIN
 DELETE FROM library_resource_adoptions WHERE source_id=OLD.source_id OR source_id=NEW.source_id;
END;
CREATE TRIGGER library_restore_txt_toc_rules_DELETE AFTER DELETE ON txt_toc_rules
 WHEN OLD.enable=1 BEGIN DELETE FROM library_resource_adoptions WHERE source_id='local' AND book_id IN (SELECT b.book_id FROM books b WHERE COALESCE(CASE WHEN json_valid(json_extract(b.book_json,'$.variables.localBookOriginal')) THEN CASE WHEN json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.schemaVersion')=1 AND json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.provenance')='rawBytes' AND json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.bookId')=b.book_id AND json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.sha256')=json_extract(b.book_json,'$.variables.localBookSourceSha256') THEN json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.sourceFormat') END END,'unknown') NOT IN ('epub','pdf','mobi','azw','umd')); END;
CREATE TRIGGER library_restore_txt_toc_rules_INSERT BEFORE INSERT ON txt_toc_rules
 WHEN (NEW.enable=1 OR EXISTS(SELECT 1 FROM txt_toc_rules r WHERE r.id=NEW.id AND r.enable=1))
 AND NOT EXISTS(SELECT 1 FROM txt_toc_rules r WHERE r.id=NEW.id AND r.name IS NEW.name AND r.rule IS NEW.rule AND r.example IS NEW.example AND r.serial_number IS NEW.serial_number AND r.enable IS NEW.enable)
 BEGIN DELETE FROM library_resource_adoptions WHERE source_id='local' AND book_id IN (SELECT b.book_id FROM books b WHERE COALESCE(CASE WHEN json_valid(json_extract(b.book_json,'$.variables.localBookOriginal')) THEN CASE WHEN json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.schemaVersion')=1 AND json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.provenance')='rawBytes' AND json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.bookId')=b.book_id AND json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.sha256')=json_extract(b.book_json,'$.variables.localBookSourceSha256') THEN json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.sourceFormat') END END,'unknown') NOT IN ('epub','pdf','mobi','azw','umd')); END;
CREATE TRIGGER library_restore_txt_toc_rules_UPDATE AFTER UPDATE ON txt_toc_rules
 WHEN (OLD.enable=1 OR NEW.enable=1) AND (OLD.id IS NOT NEW.id OR OLD.name IS NOT NEW.name OR OLD.rule IS NOT NEW.rule OR OLD.example IS NOT NEW.example OR OLD.serial_number IS NOT NEW.serial_number OR OLD.enable IS NOT NEW.enable)
 BEGIN DELETE FROM library_resource_adoptions WHERE source_id='local' AND book_id IN (SELECT b.book_id FROM books b WHERE COALESCE(CASE WHEN json_valid(json_extract(b.book_json,'$.variables.localBookOriginal')) THEN CASE WHEN json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.schemaVersion')=1 AND json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.provenance')='rawBytes' AND json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.bookId')=b.book_id AND json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.sha256')=json_extract(b.book_json,'$.variables.localBookSourceSha256') THEN json_extract(json_extract(b.book_json,'$.variables.localBookOriginal'),'$.sourceFormat') END END,'unknown') NOT IN ('epub','pdf','mobi','azw','umd')); END;
