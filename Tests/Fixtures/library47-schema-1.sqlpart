CREATE TRIGGER directory_local_readability_guard AFTER UPDATE OF payload ON cache
        WHEN substr(NEW.key,1,45)='reading.directory.guard.v2:local_book.v1.toc:' AND NEW.payload IS NOT OLD.payload
        BEGIN DELETE FROM cache WHERE key='reading.directory.facts.v2:5:local:'||substr(NEW.key,46)
            AND CASE WHEN json_valid(payload) THEN json_extract(payload,'$.adapterVersion') END='local-txt-readable-v1'; END;
CREATE TRIGGER directory_local_readability_rules_insert AFTER INSERT ON cache
            WHEN substr(NEW.key,1,27)='reading.directory.rules.v2:'
            BEGIN DELETE FROM cache WHERE key='reading.directory.facts.v2:5:local:'||substr(NEW.key,27+instr(substr(NEW.key,28),':')+1)
                AND CASE WHEN json_valid(payload) THEN json_extract(payload,'$.adapterVersion') END='local-txt-readable-v1'; END;
CREATE TRIGGER directory_local_readability_rules_update AFTER UPDATE OF payload ON cache
            WHEN substr(NEW.key,1,27)='reading.directory.rules.v2:'
            BEGIN DELETE FROM cache WHERE key='reading.directory.facts.v2:5:local:'||substr(NEW.key,27+instr(substr(NEW.key,28),':')+1)
                AND CASE WHEN json_valid(payload) THEN json_extract(payload,'$.adapterVersion') END='local-txt-readable-v1'; END;
CREATE TRIGGER directory_source_catalog_delete AFTER DELETE ON sources BEGIN
                UPDATE reader_catalog_index_rows SET readable_position=NULL WHERE substr(toc_key,1,length('remote_book.v1.toc:'||length(CAST(OLD.source_id AS BLOB))||':'||OLD.source_id||':'))='remote_book.v1.toc:'||length(CAST(OLD.source_id AS BLOB))||':'||OLD.source_id||':' AND EXISTS(SELECT 1 FROM cache WHERE key='reading.directory.facts.v2:'||substr(toc_key,20));
                UPDATE reader_catalog_index_meta SET readable_count=0,
                    revision='dir2-stale-source:'||substr(revision,instr(revision,':')+1)
                    WHERE substr(toc_key,1,length('remote_book.v1.toc:'||length(CAST(OLD.source_id AS BLOB))||':'||OLD.source_id||':'))='remote_book.v1.toc:'||length(CAST(OLD.source_id AS BLOB))||':'||OLD.source_id||':' AND EXISTS(SELECT 1 FROM cache WHERE key='reading.directory.facts.v2:'||substr(toc_key,20));
                INSERT OR IGNORE INTO reader_catalog_index_meta(toc_key,revision,chapter_count,readable_count)
                    SELECT key,'dir2-stale-source:'||lower(hex(randomblob(32))),0,0 FROM cache AS toc
                    WHERE substr(key,1,length('remote_book.v1.toc:'||length(CAST(OLD.source_id AS BLOB))||':'||OLD.source_id||':'))='remote_book.v1.toc:'||length(CAST(OLD.source_id AS BLOB))||':'||OLD.source_id||':'
                    AND EXISTS(SELECT 1 FROM cache AS facts WHERE facts.key='reading.directory.facts.v2:'||substr(toc.key,20))
                    AND NOT EXISTS(SELECT 1 FROM reader_catalog_index_meta AS meta WHERE meta.toc_key=toc.key);
            END;
