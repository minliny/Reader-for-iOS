CREATE TRIGGER library_restore_book_resources_books_DELETE AFTER DELETE ON books BEGIN DELETE FROM library_resource_adoptions WHERE kind IN ('bookCover','localOriginal') AND source_id='local' AND book_id=OLD.book_id; END;
CREATE TRIGGER library_restore_book_resources_books_INSERT AFTER INSERT ON books BEGIN DELETE FROM library_resource_adoptions WHERE kind IN ('bookCover','localOriginal') AND source_id='local' AND book_id=NEW.book_id; END;
CREATE TRIGGER library_restore_book_resources_books_UPDATE AFTER UPDATE ON books BEGIN DELETE FROM library_resource_adoptions WHERE kind IN ('bookCover','localOriginal') AND source_id='local' AND book_id=OLD.book_id;DELETE FROM library_resource_adoptions WHERE kind IN ('bookCover','localOriginal') AND source_id='local' AND book_id=NEW.book_id; END;
CREATE TRIGGER library_restore_book_resources_source_books_DELETE AFTER DELETE ON source_books BEGIN DELETE FROM library_resource_adoptions WHERE kind IN ('bookCover','localOriginal') AND source_id=OLD.source_id AND book_id=OLD.book_id; END;
CREATE TRIGGER library_restore_book_resources_source_books_INSERT AFTER INSERT ON source_books BEGIN DELETE FROM library_resource_adoptions WHERE kind IN ('bookCover','localOriginal') AND source_id=NEW.source_id AND book_id=NEW.book_id; END;
CREATE TRIGGER library_restore_book_resources_source_books_UPDATE AFTER UPDATE ON source_books BEGIN DELETE FROM library_resource_adoptions WHERE kind IN ('bookCover','localOriginal') AND source_id=OLD.source_id AND book_id=OLD.book_id;DELETE FROM library_resource_adoptions WHERE kind IN ('bookCover','localOriginal') AND source_id=NEW.source_id AND book_id=NEW.book_id; END;
CREATE TRIGGER library_restore_cache_DELETE AFTER DELETE ON cache BEGIN DELETE FROM library_resource_adoptions WHERE kind IN ('toc','localNavigation') AND item=OLD.key; END;
